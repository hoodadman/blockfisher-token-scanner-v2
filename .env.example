# Copy to .env.local. Only the dev server reads these; they are never sent to the browser.
INSIGHTX_API_KEY=
TWITTER_BEARER_TOKEN=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Optional. Used only by the summary under the triangle. Never sent to the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Optional. Blockchain nodes for our own contract reads. Leave blank to use free public nodes.
# A provider URL (Alchemy, QuickNode, Helius) can include its key, so it stays on the server.
ETH_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
SOLANA_RPC_URL=
